# Copy to .env.local for local development. In deployed environments these come
# from apphosting.yaml (production) and apphosting.staging.yaml (staging).

# ---- Firebase web app (public, safe in the browser) ----
# Point these at the STAGING project for local development.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=the-cx-assembly
NEXT_PUBLIC_FIREBASE_APP_ID=1:495318982977:web:841372ff381894195d81c0
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=the-cx-assembly.firebasestorage.app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDBeGegBBI4g1h_xd-TZ2EwXFeQn07ERss
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=the-cx-assembly.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=495318982977

# ---- Firebase Admin (server only) ----
# Without credentials the site runs on sample content and nothing is saved.
# Either fill these from a service-account key (staging project only, never
# production), or run `gcloud auth application-default login` instead.
FIREBASE_PROJECT_ID=the-cx-assembly
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Admin sessions (required to sign in to /admin) ----
# 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=your_admin_session_secret

# ---- Site ----
# Public address used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "staging" hides the site from search engines and shows a STAGING banner.
NEXT_PUBLIC_APP_ENV=development

# ---- Optional ----
# Google Tag Manager container (public pages only), e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Google Search Console "HTML tag" verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
