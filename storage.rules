rules_version = '2';

// All uploads go through the server (Admin SDK), which bypasses these rules.
// These rules only decide what browsers may read directly.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'abhishekroks12345@gmail.com'
      );
    }

    // Public assets: speaker photos, uploaded videos, thumbnails.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else is private, including gated PDFs under private/:
    // visitors only get them through /api/resources/:id/download after the form.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
